<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    One executable, several protocol modes. The mode (modbus or s7) is chosen per instance with CONNECTOR_PROTOCOL
    or the protocol command-line option. The container image bakes a default mode in through the ConnectorProtocol property:
      dotnet publish -t:PublishContainer -p:ConnectorProtocol=s7
  -->
  <PropertyGroup>
    <RootNamespace>AioIndustrialConnector.Host</RootNamespace>
    <AssemblyName>IndustrialConnector</AssemblyName>
    <Version>0.2.0</Version>
    <ConnectorProtocol Condition="'$(ConnectorProtocol)' == ''">modbus</ConnectorProtocol>
    <ContainerRepository>aio-$(ConnectorProtocol)-connector</ContainerRepository>
    <ContainerImageTag>$(Version)</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\IndustrialConnector.Core\IndustrialConnector.Core.csproj" />
    <ProjectReference Include="..\..\Modbus\IndustrialConnector.Modbus\IndustrialConnector.Modbus.csproj" />
    <ProjectReference Include="..\..\S7\IndustrialConnector.S7\IndustrialConnector.S7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ContainerEnvironmentVariable Include="CONNECTOR_PROTOCOL" Value="$(ConnectorProtocol)" />
  </ItemGroup>

</Project>
